{
    "version": "1.3.0",
    "name": "@ivuorinen/stylelint-a11y",
    "description": "Plugin for stylelint with a11y rules",
    "main": "dist/index.js",
    "types": "types/index.d.ts",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./dist/index.js"
        },
        "./recommended": "./recommended.js",
        "./package.json": "./package.json"
    },
    "repository": "https://github.com/ivuorinen/stylelint-a11y.git",
    "author": "Stanislav <botev.st@gmail.com>",
    "maintainers": [
        {
            "name": "Ismo Vuorinen",
            "url": "https://github.com/ivuorinen"
        }
    ],
    "license": "MIT",
    "keywords": [
        "stylelint",
        "stylelint-plugin",
        "a11y"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "type": "module",
    "scripts": {
        "precommit": "lint-staged",
        "prebuild": "rimraf dist",
        "build": "babel src --out-dir dist --ignore \"src/**/__tests__/**\",\"src/**/*.test.js\"",
        "lint": "eslint",
        "prettify": "prettier '**/*.js' --write",
        "prepack": "npm run build",
        "pretest": "npm run lint",
        "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" npx jest --runInBand",
        "coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" npx jest --coverage",
        "smoke": "npm run build && node scripts/smoke-package.mjs",
        "release": "release-it"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "trailingComma": "es5"
    },
    "lint-staged": {
        "**/*.{js,json}": [
            "prettier --write",
            "git add"
        ]
    },
    "peerDependencies": {
        "stylelint": "^17"
    },
    "dependencies": {
        "postcss-selector-parser": "^7"
    },
    "devDependencies": {
        "@babel/cli": "^7",
        "@babel/core": "^7",
        "@babel/preset-env": "^7",
        "@eslint/js": "^10",
        "babel-jest": "^30",
        "babel-preset-jest": "^30",
        "cross-env": "^10",
        "eslint": "^10",
        "eslint-config-prettier": "^10",
        "eslint-plugin-jest": "^29",
        "eslint-plugin-prettier": "^5",
        "jest": "^30",
        "jest-preset-stylelint": "^9",
        "postcss": "^8.4.32",
        "prettier": "^3",
        "release-it": "^21.0.0",
        "rimraf": "^6",
        "stylelint": "^17"
    },
    "publishConfig": {
        "access": "public"
    },
    "release-it": {
        "git": {
            "commitMessage": "Release v${version}",
            "requireBranch": "master"
        },
        "github": {
            "release": true,
            "web": true
        },
        "npm": {
            "publish": true
        }
    },
    "files": [
        "README.md",
        "recommended.js",
        "dist/**/*.js",
        "types/index.d.ts"
    ],
    "overrides": {
        "undici": ">=7.27.3"
    }
}
