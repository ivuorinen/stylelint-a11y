{
    "version": "1.3.0",
    "name": "@ivuorinen/stylelint-a11y",
    "description": "Plugin for stylelint with a11y rules",
    "main": "dist/index.js",
    "repository": "https://github.com/ivuorinen/stylelint-a11y.git",
    "author": "Stanislav <botev.st@gmail.com>",
    "maintainers": [
        {
            "name": "Ismo Vuorinen",
            "url": "https://github.com/ivuorinen"
        }
    ],
    "license": "MIT",
    "keywords": [
        "stylelint",
        "stylelint-plugin",
        "a11y"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "type": "module",
    "scripts": {
        "precommit": "lint-staged",
        "prebuild": "rimraf dist",
        "build": "babel src --out-dir dist",
        "lint": "eslint",
        "prettify": "prettier '**/*.js' --write",
        "prepublish": "npm run build",
        "pretest": "npm run lint -- --fix",
        "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" npx jest --runInBand",
        "coverage": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" npx jest --coverage",
        "release": "release-it"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "trailingComma": "es5"
    },
    "lint-staged": {
        "**/*.{js,json}": [
            "prettier --write",
            "git add"
        ]
    },
    "peerDependencies": {
        "stylelint": "^17"
    },
    "devDependencies": {
        "@babel/cli": "^7",
        "@babel/core": "^7",
        "@babel/preset-env": "^7",
        "babel-jest": "^30",
        "babel-preset-jest": "^30",
        "cross-env": "^10",
        "eslint": "^10",
        "eslint-config-prettier": "^10",
        "eslint-config-stylelint": "^27",
        "eslint-plugin-jest": "^29",
        "eslint-plugin-prettier": "^5",
        "jest": "^30",
        "jest-cli": "^30",
        "jest-preset-stylelint": "^9",
        "postcss": "^8.4.32",
        "prettier": "^3",
        "release-it": "^19",
        "rimraf": "^6",
        "stylelint": "^17"
    },
    "publishConfig": {
        "access": "public"
    },
    "release-it": {
        "git": {
            "commitMessage": "Release v${version}",
            "requireBranch": "master"
        },
        "github": {
            "release": true,
            "web": true
        },
        "npm": {
            "publish": true
        }
    },
    "files": [
        "README.md",
        "recommended.js",
        "dist/**/*.js"
    ],
    "overrides": {
        "undici": ">=6.24.0"
    }
}
